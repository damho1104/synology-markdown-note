# NAS URL may be blank for the administrator-protected web setup wizard.
NAS_URL=
# Set true only if the configured NAS uses a private LAN IP/domain.
NAS_ALLOW_PRIVATE=false
# Mount a trusted CA bundle if your NAS does not have a public CA cert.
NAS_CA_FILE=
# Must equal the browser-visible HTTPS origin behind a reverse proxy.
# Leave blank only for same-scheme direct development access.
WEB_PUBLIC_ORIGIN=
# For localhost HTTP development only: WEB_COOKIE_SECURE=false
WEB_COOKIE_SECURE=true
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8787
