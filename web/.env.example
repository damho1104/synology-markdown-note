# Docker image used by docker-compose.yaml (override to deploy another tag).
WEB_IMAGE=dr.dmomo.net/damho1104/synonote-web:0.2.0

# Persistent /data storage: Docker named volume by default.
# For a NAS bind mount, create and secure the directory before starting:
# WEB_DATA_PATH=/volume1/docker/synonote-web/data
WEB_DATA_PATH=synonote-web-data

# NAS URL may be blank for the administrator-protected web setup wizard.
# HTTP works for trusted internal networks but does not encrypt NAS credentials.
NAS_URL=
# Set true to permit private LAN addresses and unencrypted HTTP NAS connections.
NAS_ALLOW_PRIVATE=false
# Mount a trusted CA bundle if your NAS does not have a public CA cert.
NAS_CA_FILE=
# Must equal the browser-visible HTTPS origin behind a reverse proxy.
# Leave blank only for same-scheme direct development access.
WEB_PUBLIC_ORIGIN=
# For localhost HTTP development only: WEB_COOKIE_SECURE=false
WEB_COOKIE_SECURE=true
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8787
