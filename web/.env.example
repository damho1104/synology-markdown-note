# All variables below are optional and have Compose defaults.
# A NAS address is required before login: set NAS_URL OR use the web setup wizard.
# Optional: public GHCR image, published by GitHub Actions.
WEB_IMAGE=ghcr.io/damho1104/synology-md-note-web:latest

# Persistent /data storage: Docker named volume by default.
# For a NAS bind mount, create and secure the directory before starting:
# WEB_DATA_PATH=/volume1/docker/synonote-web/data
WEB_DATA_PATH=synonote-web-data

# NAS URL may be blank for the administrator-protected web setup wizard.
# HTTP works for trusted internal networks but does not encrypt NAS credentials.
NAS_URL=
# Required true ONLY for private LAN addresses or HTTP NAS connections.
NAS_ALLOW_PRIVATE=false
# OPTIONAL: private CA / self-signed HTTPS only. Omit for public CA or HTTP.
# NAS_CA_FILE is a container path and also needs a file mount if set manually.
# NAS_CA_FILE=/etc/synonote/nas-ca.pem
# Uncomment the optional read-only CA mount in docker-compose.yaml if needed.
# Browser origin and HTTP/HTTPS cookies are detected automatically.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8787

# Web UI language: auto follows browser preferences and falls back to English.
# Use en for English or ko for Korean for all visitors.
WEB_DEFAULT_LANGUAGE=auto

# Advanced compatibility only: leave these defaults for ordinary deployments.
# WEB_PUBLIC_ORIGIN=https://notes.example.com
# WEB_COOKIE_SECURE=auto
